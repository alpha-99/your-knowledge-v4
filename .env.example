# ============================================================
# AI 知识库 V3 — 环境变量模板
# 复制为 .env 并填入真实值
# ============================================================

# --- LLM 配置 ---
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- 成本控制 ---
# 输入 token 单价（元/百万 token）
PRICE_INPUT_PER_MILLION=1.0
# 输出 token 单价（元/百万 token）
PRICE_OUTPUT_PER_MILLION=2.0
# 单次运行预算上限（元）
BUDGET_LIMIT_YUAN=1.0

# --- GitHub API ---
GITHUB_TOKEN=ghp_your-github-token-here

# --- RSS 多源采集 ---
# 是否启用 RSS 多源采集（1/0，默认开启）
RSS_ENABLED=1
# RSS 每源抓取上限复用 plan 的 per_source_limit（与 GitHub 同一变量）
# 注意：RSS 是"每源"上限 → 11 个源 × per_source_limit = 总条数
# RSS 配置路径（可选，默认 pipeline/rss_sources.yaml）
# RSS_CONFIG_PATH=pipeline/rss_sources.yaml

# --- 安全配置 ---
# 速率限制（每分钟最大调用次数）
RATE_LIMIT_PER_MINUTE=60

FEISHU=""